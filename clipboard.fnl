"
Clipboard history: remembers the text you copy and pastes it back from the
minibuffer.

  RET    paste into the frontmost app     s-RET  copy without pasting
  s-l    Large Type                       s-DEL  forget the entry

Copies that apps mark as concealed or transient (password managers do) are
not recorded. The history is kept in Hammerspoon's settings.
"
(local minibuffer (require :lib.minibuffer))
(local large-type (require :lib.large-type))

(local settings-key "clipboard.history")
(local max-entries 200)
(local max-length 20000)
(local ignored-types {"org.nspasteboard.ConcealedType" true
                      "org.nspasteboard.TransientType" true
                      "org.nspasteboard.AutoGeneratedType" true
                      "com.agilebits.onepassword" true})

(var watcher nil)

(fn history [] (or (hs.settings.get settings-key) []))

(fn save [entries] (hs.settings.set settings-key entries))

(fn ignored? []
  (accumulate [found false _ t (ipairs (or (hs.pasteboard.contentTypes) []))]
    (or found (not= nil (. ignored-types t)))))

(fn remember [text]
  "Put TEXT at the front of the history."
  (when (and text (not= (text:gsub "%s" "") "") (<= (length text) max-length))
    (let [front (hs.application.frontmostApplication)
          entries [{: text :time (os.time) :app (and front (: front :name))}]]
      (each [_ e (ipairs (history))]
        (when (and (not= e.text text) (< (length entries) max-entries))
          (table.insert entries e)))
      (save entries))))

(fn forget [text]
  (save (icollect [_ e (ipairs (history))]
          (when (not= e.text text) e))))

(fn clear []
  (save [])
  (minibuffer.message "Clipboard history cleared"))

(fn ago [time]
  (let [s (- (os.time) (or time 0))]
    (if (< s 60) "now"
        (< s 3600) (.. (math.floor (/ s 60)) "m ago")
        (< s 86400) (.. (math.floor (/ s 3600)) "h ago")
        (.. (math.floor (/ s 86400)) "d ago"))))

(fn paste [text]
  (hs.pasteboard.setContents text)
  ;; Give the pasteboard and the minibuffer's key tap a moment.
  (hs.timer.doAfter 0.05 #(hs.eventtap.keyStroke [:cmd] :v 0)))

(fn show []
  "Pick an entry of the clipboard history and paste it."
  (if (= (length (history)) 0)
      (minibuffer.message "The clipboard history is empty")
      (minibuffer.completing-read
       "Paste: "
       (icollect [_ e (ipairs (history))]
         {:text e.text
          :annotation (.. (or e.app "") "  " (ago e.time))
          :entry e})
       {:on-accept (fn [candidate _ flags]
                     (when candidate
                       (if flags.cmd
                           (do (hs.pasteboard.setContents candidate.entry.text)
                             (minibuffer.message "Copied"))
                           (paste candidate.entry.text))))
        :actions {"s-l" #(when $1 (large-type.show $1.entry.text))
                  "s-DEL" #(when $1
                             (forget $1.entry.text)
                             (show))}})))

(fn init []
  (set watcher (hs.pasteboard.watcher.new
                (fn [text]
                  (when (and text (not (ignored?)))
                    (remember text)))))
  (: watcher :start)
  watcher)

{: init
 : show
 : clear
 : history}
