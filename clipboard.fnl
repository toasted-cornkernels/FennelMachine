"
Clipboard history: remembers the text you copy and pastes it back from the
minibuffer.

  RET    paste into the frontmost app     s-RET  copy without pasting
  s-l    Large Type                       s-DEL  forget the entry

Like Emacs' kill ring, the history lives only in memory: it is never written
to disk and is gone when Hammerspoon reloads or quits. To keep secrets out of
it, a copy is not recorded when:

- the app marks it concealed or transient (see nspasteboard.org),
- a password manager is the frontmost app,
- it looks like a secret: a known token or key format, a private key, an
  assignment such as PASSWORD=..., or a single password-like word, or
- recording is paused.
"
(local minibuffer (require :lib.minibuffer))
(local large-type (require :lib.large-type))

(local legacy-settings-key "clipboard.history")
(local max-entries 200)
(local max-length 20000)

(local ignored-types {"org.nspasteboard.ConcealedType" true
                      "org.nspasteboard.TransientType" true
                      "org.nspasteboard.AutoGeneratedType" true
                      "com.agilebits.onepassword" true
                      "com.typeit4me.clipping" true
                      "de.petermaurer.TransientPasteboardType" true
                      "Pasteboard generator type" true
                      "net.antelle.keeweb" true})

(local ignored-apps {"com.apple.Passwords" true
                     "com.apple.keychainaccess" true
                     "me.proton.pass.electron" true
                     "me.proton.pass.catalyst" true
                     "com.1password.1password" true
                     "com.agilebits.onepassword7" true
                     "com.bitwarden.desktop" true
                     "org.keepassxc.keepassxc" true
                     "com.lastpass.LastPass" true
                     "com.dashlane.dashlanephonefinal" true
                     "in.sinew.Enpass-Desktop" true})

(local token-patterns
       ["^gh[pousr]_%w+$" "^github_pat_[%w_]+$" "^glpat%-[%w%-_]+$"
        "^sk%-[%w%-_]+$" "^[sr]k_live_%w+$" "^xox[abposr]%-[%w%-]+$"
        "^A[KS]IA[%u%d]+$" "^AIza[%w%-_]+$" "^npm_%w+$"
        "^eyJ[%w%-_]+%.eyJ[%w%-_]+%.[%w%-_]+$"])

(local secret-names [:password :passwd :secret :token :api_key :apikey
                     :access_key :private_key :credential])

(var entries [])
(var paused false)
(var watcher nil)

(fn history [] entries)

(fn password-like? [word]
  "Mixed letters, digits and symbols, as password generators make them."
  (let [n (length word)
        lower (word:find "%l")
        upper (word:find "%u")
        digit (word:find "%d")
        punct (word:find "%p")]
    (and (not (word:find "://"))
         (not (word:find "^[/~]"))
         (or (and (<= 8 n 64) lower upper digit punct)
             (and (<= 16 n 128) lower upper digit (not punct))))))

(fn secret-assignment? [text]
  "NAME=VALUE or NAME: VALUE with a secret-sounding NAME and a literal VALUE:
quoted, or unquoted with a digit (so code like token = get_token() passes)."
  (let [lower (text:lower)]
    (accumulate [found false _ name (ipairs secret-names)]
      (or found
          (accumulate [hit false q value
                       (lower:gmatch (.. name "[%w_]*%s*[=:]%s*([\"']?)([^%s\"',;]+)"))]
            (or hit
                (and (>= (length value) 6)
                     (or (not= q "")
                         (and (value:find "%d") (not (value:find "[()]")))))))))))

(fn secret? [text]
  (let [word (text:match "^%s*(%S+)%s*$")]
    (or (not= nil (text:find "%-%-%-%-%-BEGIN [%u ]*PRIVATE KEY"))
        (and word
             (or (accumulate [found false _ p (ipairs token-patterns)]
                   (or found (not= nil (word:find p))))
                 (password-like? word)))
        (secret-assignment? text))))

(fn ignored? []
  (let [front (hs.application.frontmostApplication)]
    (or (and front (. ignored-apps (or (: front :bundleID) "")))
        (accumulate [found false _ t (ipairs (or (hs.pasteboard.contentTypes) []))]
          (or found (not= nil (. ignored-types t)))))))

(fn remember [text]
  "Put TEXT at the front of the history."
  (when (and text (not= (text:gsub "%s" "") "") (<= (length text) max-length)
             (not (secret? text)))
    (let [front (hs.application.frontmostApplication)
          new [{: text :time (os.time) :app (and front (: front :name))}]]
      (each [_ e (ipairs entries)]
        (when (and (not= e.text text) (< (length new) max-entries))
          (table.insert new e)))
      (set entries new))))

(fn forget [text]
  (set entries (icollect [_ e (ipairs entries)]
                 (when (not= e.text text) e))))

(fn clear []
  (set entries [])
  (minibuffer.message "Clipboard history cleared"))

(fn confirm-clear []
  "Clear the clipboard history after asking."
  (minibuffer.y-or-n-p "Clear the clipboard history?" clear))

(fn paused? [] paused)

(fn set-paused [p]
  (set paused p)
  (minibuffer.message (if paused
                          "Clipboard history paused"
                          "Clipboard history resumed")))

(fn pause []
  "Stop recording the clipboard."
  (set-paused true))

(fn resume []
  "Record the clipboard again."
  (set-paused false))

(fn toggle-pause []
  "Pause or resume recording the clipboard."
  (set-paused (not paused)))

(fn ago [time]
  (let [s (- (os.time) (or time 0))]
    (if (< s 60) "now"
        (< s 3600) (.. (math.floor (/ s 60)) "m ago")
        (< s 86400) (.. (math.floor (/ s 3600)) "h ago")
        (.. (math.floor (/ s 86400)) "d ago"))))

(fn paste [text]
  (hs.pasteboard.setContents text)
  ;; Give the pasteboard and the minibuffer's key tap a moment.
  (hs.timer.doAfter 0.05 #(hs.eventtap.keyStroke [:cmd] :v 0)))

(fn show []
  "Pick an entry of the clipboard history and paste it."
  (if (= (length entries) 0)
      (minibuffer.message "The clipboard history is empty")
      (minibuffer.completing-read
       "Paste: "
       (icollect [_ e (ipairs entries)]
         {:text e.text
          :annotation (.. (or e.app "") "  " (ago e.time))
          :entry e})
       {:on-accept (fn [candidate _ flags]
                     (when candidate
                       (if flags.cmd
                           (do (hs.pasteboard.setContents candidate.entry.text)
                             (minibuffer.message "Copied"))
                           (paste candidate.entry.text))))
        :actions {"s-l" #(when $1 (large-type.show $1.entry.text))
                  "s-DEL" #(when $1
                             (forget $1.entry.text)
                             (show))}})))

(fn init []
  ;; Earlier versions saved the history to disk; erase it.
  (when (hs.settings.get legacy-settings-key)
    (hs.settings.clear legacy-settings-key))
  (set watcher (hs.pasteboard.watcher.new
                (fn [text]
                  (when (and text (not paused) (not (ignored?)))
                    (remember text)))))
  (: watcher :start)
  watcher)

{: init
 : show
 : clear
 : confirm-clear
 : history
 : paused?
 : pause
 : resume
 : toggle-pause
 : secret?}
